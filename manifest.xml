<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>7f3e2b1a-6c4d-4e8f-9a0b-1c2d3e4f5a6b</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Dutch Fire Safety Group</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="DFSG Inbox Agent"/>
  <Description DefaultValue="Zijpaneel in Outlook: tab Inbox (voorstel van de agent controleren en doorzetten) en tab Archief (mailarchief doorzoeken, labels en koppelingen corrigeren). Verstuurt nooit zelf mail."/>
  <IconUrl DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://www.dfsg.nl"/>
  <AppDomains>
    <AppDomain>https://kattestaart.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/index.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Taskpane.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgReadOpenPaneButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
          <MobileFormFactor>
            <FunctionFile resid="Taskpane.Url"/>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="mobileMsgRead">
                <Label resid="GroupLabel"/>
                <Control xsi:type="MobileButton" id="mobileOpenPane">
                  <Label resid="TaskpaneButton.Label"/>
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="Icon.32x32"/>
                    <bt:Image size="25" scale="2" resid="Icon.32x32"/>
                    <bt:Image size="25" scale="3" resid="Icon.32x32"/>
                    <bt:Image size="32" scale="1" resid="Icon.32x32"/>
                    <bt:Image size="32" scale="2" resid="Icon.32x32"/>
                    <bt:Image size="32" scale="3" resid="Icon.32x32"/>
                    <bt:Image size="48" scale="1" resid="Icon.80x80"/>
                    <bt:Image size="48" scale="2" resid="Icon.80x80"/>
                    <bt:Image size="48" scale="3" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://kattestaart.github.io/inbox-agent-paneel/index.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="DFSG"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Inbox Agent"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Opent het DFSG-zijpaneel: Inbox (controleren en doorzetten) en Archief (zoeken en corrigeren). Vastzetten met de punaise houdt het paneel open."/>
        </bt:LongStrings>
      </Resources>
      <SupportsSharedFolders>true</SupportsSharedFolders>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
